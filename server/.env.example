# Server Environment Variables

NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# --- Firebase Admin Configuration ---
# Option 1: Path to Firebase Service Account JSON file (recommended for local dev)
FIREBASE_SERVICE_ACCOUNT_PATH=./config/serviceAccountKey.json

# Option 2: Direct environment variables (recommended for cloud deployments like Render/Railway/Heroku)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-firebase-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# Firebase Storage Bucket (e.g., your-project-id.appspot.com or your-project-id.firebasestorage.app)
FIREBASE_STORAGE_BUCKET=your-firebase-project-id.appspot.com

# --- Application Security ---
MAX_UPLOAD_MB=8
SEED_ADMIN_EMAIL=admin@kestrel.dev
SEED_ADMIN_PASSWORD=ChangeMe123!
